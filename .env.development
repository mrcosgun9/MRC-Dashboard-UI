# Development environment variables
# Copy anything sensitive into a local untracked .env.local if needed.
# These defaults target local docker / local services.

# API endpoints
BASE_API="https://api.realdates.online/api/"
NEXT_PUBLIC_BASE_API="https://api.realdates.online/api/"
NEXT_PUBLIC_CHAT_HUB="https://api.realdates.online/chatHub"

# App domain (used when constructing absolute image URLs)
NEXT_PUBLIC_APP_DOMAIN="https://realdates.online"

# NextAuth
NEXTAUTH_URL="https://localhost:3000"
AUTH_SECRET="dev-admin-secret" # override in .env.local for real usage

# Prisma / Database (adjust for your local DB). Example for local Postgres docker.
# Remember: never commit real production credentials here.
DATABASE_URL="postgresql://postgres:hrvqUsYpSE68cztT3d@212.98.224.183:5432/RealDatesNewDb?schema=public"

# File system path where public uploads will be stored when running locally.
# For Next.js the public folder resolves to <projectRoot>/public. Use absolute path to that for server actions writing files.
MAIN_APP_PUBLIC_PATH=/var/www/realdates.online/public

# Node environment hint (Next.js sets automatically via scripts, optional)
# NODE_ENV=development
